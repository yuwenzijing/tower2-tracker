BEGIN:VEVENT
UID:github-token-20261020@tower2-tracker
DTSTART;TZID=Asia/Shanghai:20261020T090000
DTEND;TZID=Asia/Shanghai:20261020T093000
SUMMARY:⚠️ GitHub Token 到期 - 立即续期
DESCRIPTION:GitHub Personal Access Token (PAT) 今天到期！\n\n操作步骤：\n1. 访问 https://github.com/settings/tokens\n2. 找到 tower2-tracker 使用的 Token\n3. 点击 Regenerate token，有效期选 90 天\n4. 复制新 Token 更新到本地 git 配置\n5. 在日历中更新下次到期提醒日期（+90天）\n\n⚠️ 续期后记得更新下一次提醒时间！
RRULE:FREQ=DAILY;INTERVAL=90
BEGIN:VALARM
TRIGGER:-P7D
ACTION:DISPLAY
DESCRIPTION:GitHub Token 将在 7 天后到期，请准备续期
END:VALARM
BEGIN:VALARM
TRIGGER:-P3D
ACTION:DISPLAY
DESCRIPTION:GitHub Token 将在 3 天后到期，请尽快续期
END:VALARM
BEGIN:VALARM
TRIGGER:-P1D
ACTION:DISPLAY
DESCRIPTION:GitHub Token 明天到期！请立即续期
END:VALARM
END:VEVENT

